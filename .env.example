# Docker Compose reads .env automatically; native Python uses shell variables.
# Copy this file to .env locally. Never commit .env or put real keys here.

# Dashboard port on this computer. The container always listens on port 8768;
# the published address stays 127.0.0.1 (local access only).
LM_BENCHLAB_PORT=8768

# Default inference host visible from the container. Set a container hostname
# instead if the inference server shares the llm-lab-net Docker network.
LM_BENCHLAB_DEFAULT_ENGINE_HOST=host.docker.internal

# Optional: required only for saving encrypted engine API keys.
# Generate a Fernet key using the README command. Keep it private, backed up
# and unchanged across restarts/upgrades so saved keys remain readable.
LM_BENCHLAB_MASTER_KEY=
